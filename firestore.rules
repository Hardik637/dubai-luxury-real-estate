rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. CLIENT ENQUIRIES & LEAD VAULT
    // - Anyone can submit an enquiry from public website forms
    // - Admin dashboard reads and manages leads
    // =========================================================================
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // =========================================================================
    // 2. PROPERTY PORTFOLIO
    // - Public visitors can read property listings
    // - Admin dashboard can add, update, or remove properties
    // =========================================================================
    match /properties/{propertyId} {
      allow read: if true;
      allow write: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
